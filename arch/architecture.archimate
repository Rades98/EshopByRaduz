    <element xsi:type="archimate:Principle" name="Regulatory oversight" id="id-ca3deba49d2c463cad371190a9620797"/>
    <element xsi:type="archimate:Outcome" name="Minimalizace finančních a právních rizik" id="id-63b5374f33b345b9b6c30dc632f09b67"/>
    <element xsi:type="archimate:Outcome" name="Bezpečná a legální nabídka produktů" id="id-7ae87f1fe074499596dd4422a5300299"/>
    <element xsi:type="archimate:Meaning" name="Prevence pokut a nesrovnalostí, správné finanční vykázání." id="id-fb69ae4a6ed84357855c50ebff20eed1"/>
    <element xsi:type="archimate:Meaning" name="Ochrana zákazníků, reputace a minimalizace právních problémů." id="id-78c4254ab6f44975a6ee4e263cf9709c"/>
    <element xsi:type="archimate:Requirement" name="Implementovat GDPR procesy pro osobní data." id="id-4bdafc3e06684ae69811a9d9c1c9caa9"/>
    <element xsi:type="archimate:Requirement" name="Provádět pravidelné interní audity." id="id-d200d4b774dc47e2aa764e062d49600e"/>
    <element xsi:type="archimate:Constraint" name="Žádné porušení GDPR." id="id-fa25e09f3cb945f382a9d80d652288ac"/>
    <element xsi:type="archimate:Constraint" name="Incidenty hlášeny a vyřešeny do 24h." id="id-a1f8fd57c70342d280f59e20243a60ec"/>
    <element xsi:type="archimate:Constraint" name="Interní audity provedeny dle plánu." id="id-05418a3e340343539ba2483aa716275b"/>
    <element xsi:type="archimate:Requirement" name="Kontrolovat správnou sazbu DPH a spotřební daně u všech produktů." id="id-97d87771b55549979a163e5b81fa9f59"/>
    <element xsi:type="archimate:Requirement" name="Implementovat automatizované ověření při změně produktů nebo cen." id="id-5cf5cf88823a4f6ab41c8b218266472c"/>
    <element xsi:type="archimate:Constraint" name="Žádný produkt nesmí mít nesprávnou daňovou sazbu." id="id-9edc77d5c2ee401e80ff4ff17a13e123"/>
    <element xsi:type="archimate:Constraint" name="Každá změna cen/produktů musí být validována z daňového hlediska." id="id-da43f5a46e0345be94dc8c30815d5c0b"/>
    <element xsi:type="archimate:Requirement" name="Nastavit metadata pro produkty s věkovým omezením." id="id-e57bccfbc4424ca4aa20e9fb871ceec4"/>
    <element xsi:type="archimate:Requirement" name="Validovat věk zákazníka při checkoutu." id="id-3b5c5551265e4b8fa9ed0c4a8c3f48aa"/>
    <element xsi:type="archimate:Constraint" name="Produkty nesmí být prodány osobám pod stanoveným minimálním věkem." id="id-7287681bd6014a83bb340ae6ce5eb821"/>
    <element xsi:type="archimate:Requirement" name="Bezvýpadkové deploye" id="id-9859654a3f2841f0875fce52340e47f0"/>
    <element xsi:type="archimate:Requirement" name="Monitoring" id="id-c6044924611945c8a9a99635365f8ca3"/>
