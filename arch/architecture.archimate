    <element xsi:type="archimate:Constraint" name="Cash flow musí být pozitivní na konci každého týdne" id="id-2f9d02bb021e444f8415417296ffd57d"/>
    <element xsi:type="archimate:Constraint" name="Reporty musí být odevzdány do 3 pracovních dnů po ukončení období" id="id-68228f725ba94382a526a4f801a7e4f5"/>
    <element xsi:type="archimate:Goal" name="Dodržet daňové předpisy" id="id-dbbc49add19c46e58a125decc60ab70d"/>
    <element xsi:type="archimate:Goal" name="Dodržet věková omezení produktů" id="id-90b2b2cae1fa438fa21bc1873d2144b6"/>
