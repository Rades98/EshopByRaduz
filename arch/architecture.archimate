    <element xsi:type="archimate:Requirement" name="Sledovat progres a blokery" id="id-6c9fcdb4bdc949929286be99aeb9e34a"/>
    <element xsi:type="archimate:Meaning" name="Přímý dopad na revenue – každé procento konverze má okamžitý finanční efekt." id="id-b89d66d5b1724e11abeebd9c20f010bf"/>
    <element xsi:type="archimate:Meaning" name="Predikovatelnost dodávek = důvěra vedení a investorů." id="id-c29bdce87521465ab5c4cbb690ce1b8d"/>
    <element xsi:type="archimate:Constraint" name="Nové změny musí být validovány daty a A/B testem" id="id-a21518092f7446e09e3c16f9279c4ca8"/>
    <element xsi:type="archimate:Constraint" name="Zpoždění nesmí překročit 10 % plánovaných milníků" id="id-e7aa8d78a84342908e1e08ab324def9b"/>
    <element xsi:type="archimate:Constraint" name="Funkcionality musí být implementovány bez výrazného dopadu na stabilitu systému" id="id-ebbb42cc7ff849ad9819c29041dfa8a5"/>
    <element xsi:type="archimate:Constraint" name="Změny scope musí být evidovány a odsouhlaseny" id="id-955e7a0e3afa4550a084b5a54f8f7119"/>
    <element xsi:type="archimate:Meaning" name="Plní trychtýř– bez návštěvnosti nemá konverze z čeho růst." id="id-8ddea41b9ee240628d9a938ef62c6cd5"/>
    <element xsi:type="archimate:Meaning" name="Zajišťuje, že marketing generuje hodnotu, ne jen náklady." id="id-fc8091fb25904262bdefd9c7b2f78883"/>
    <element xsi:type="archimate:Requirement" name="Měření Clickthrough rate (CTR)" id="id-a36ef1d201284065a550cfc7b61fe544"/>
    <element xsi:type="archimate:Requirement" name="Test kanálů (social, search, upsell,...)" id="id-ced98c374f43422abc0a248c59e80659"/>
    <element xsi:type="archimate:Constraint" name="Rozpočet kampaně nesmí překročit plánované limity" id="id-41b5b4d15bf74f9ea49c81d79b80dcee"/>
    <element xsi:type="archimate:Constraint" name="CTR nesmí klesnout pod stanovený benchmark (např. 1 %) během týdne" id="id-2a4b0eb83e274561bec1c810901fc0cc"/>
    <element xsi:type="archimate:Constraint" name="Testované kanály musí být validovány na segmenty cílové skupiny" id="id-8101182d64bc4038ba0882f8b32e4ffd"/>
    <element xsi:type="archimate:Requirement" name="Optimalizace nákladů" id="id-45a5df2de065404b80bb2c72eea64cfb"/>
    <element xsi:type="archimate:Constraint" name="ROI kampaní musí být vyšší než 1,5" id="id-f0fbeddd792945519c4cc5651726a887"/>
    <element xsi:type="archimate:Constraint" name="Náklady na jeden konverzní bod nesmí překročit plánovanou hodnotu" id="id-aea0ceaaddfe45b881d969e0a2ed27a7"/>
    <element xsi:type="archimate:Constraint" name="Každá kampaň musí mít měřitelné cíle" id="id-3367a5b173b2482e961f074ed381a0d8"/>
    <element xsi:type="archimate:Meaning" name="Zajišťuje dlouhodobou životaschopnost firmy." id="id-611b195318a44bdc8a6f77b45fb375a2"/>
    <element xsi:type="archimate:Meaning" name="Přímo ovlivňuje NPS a počet reklamací." id="id-ce15a98039ac4cf99896a3d8884282ba"/>
    <element xsi:type="archimate:Meaning" name="Umožňuje investice a škálování firmy." id="id-f68e6a30e77f4a26a3fd0f050318505f"/>
    <element xsi:type="archimate:Meaning" name="Minimalizace právních a reputačních rizik." id="id-8ae24a188941411bb738603a891fd851"/>
    <element xsi:type="archimate:Meaning" name="Technologický základ pro všechny business cíle." id="id-9432a2e562ea454e842d15455ed9ba6c"/>
    <element xsi:type="archimate:Requirement" name="Monitoring marží" id="id-af5e0bf71a994bdfaaee9e06de50c3b7"/>
    <element xsi:type="archimate:Constraint" name="Marže nesmí klesnout pod 5 %" id="id-7a6f7578bcea4970895ed9488267933d"/>
    <element xsi:type="archimate:Constraint" name="Tržby musí dosahovat minimálně 95 % plánovaných cílů" id="id-e63368aefe5a480fad6bf3e0f43ea10f"/>
    <element xsi:type="archimate:Constraint" name="Návrh projektů nesmí negativně ovlivnit cash flow" id="id-131424755d0b415cb803bd5f302ce07a"/>
    <element xsi:type="archimate:Requirement" name="95 % do 24h" id="id-1f00bb8d79f84c6997357f0658325a0e"/>
    <element xsi:type="archimate:Requirement" name="Optimalizace skladu" id="id-87cec54ef4f94903abf1e596a899e53e"/>
    <element xsi:type="archimate:Constraint" name="95 % objednávek musí být expedováno do 24 hodin" id="id-4ad7d100ba814b36886cde17d9c89732"/>
    <element xsi:type="archimate:Constraint" name="Chyby v expedici nesmí přesáhnout 2 %" id="id-9c1a0ef7a221479aa5dee500c6e2918e"/>
    <element xsi:type="archimate:Constraint" name="Skladové zásoby musí být aktualizovány v reálném čase" id="id-c257471490da4dfcb8e7dbe3d4a28810"/>
    <element xsi:type="archimate:Requirement" name="Sledování marží" id="id-3c40344f302f45f4954e66fdf5a0471e"/>
    <element xsi:type="archimate:Requirement" name="Cashflow reporting" id="id-19744be11ddc40f3885f9438106009ed"/>
